# ==============================================================================
# Civic Hub Thailand - Monorepo Environment Configuration
# ==============================================================================

# Database Connection (Neon Serverless PostgreSQL with pgBouncer pooling)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_secretpassword@ep-cool-butterfly-123456-pooler.ap-southeast-1.neon.tech/civichub?sslmode=require"

# Direct Connection URL (Used by Prisma for migrations without connection pooling)
DIRECT_URL="postgresql://neondb_owner:npg_secretpassword@ep-cool-butterfly-123456.ap-southeast-1.neon.tech/civichub?sslmode=require"

# Backend Configuration
PORT=5000
BACKEND_PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_LINE_ID="@civichubth"
NEXT_PUBLIC_HOTLINE="089-123-4567"
